<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="2024-12-26-create_posts_tables" author="iapaschenko">
        <createTable tableName="posts" remarks="Посты">
            <column name="id"                  type="UUID"         remarks="Идентификатор поста"/>
            <column name="api_id"              type="BIGINT"       remarks="Идентификатор поста на стороне провайдера"/>
            <column name="title"               type="TEXT"         remarks="Заголовок поста"/>
            <column name="body"                type="TEXT"         remarks="Тело поста"/>
            <column name="user_id"             type="UUID"         remarks="Идентификатор автора"/>
        </createTable>

        <addPrimaryKey tableName="posts" columnNames="id"/>

        <addNotNullConstraint tableName="posts" columnName="api_id"/>
        <addNotNullConstraint tableName="posts" columnName="title"/>
        <addNotNullConstraint tableName="posts" columnName="body"/>
        <addNotNullConstraint tableName="posts" columnName="user_id"/>
        <addForeignKeyConstraint baseTableName="posts" baseColumnNames="user_id"
                                 constraintName="fk_posts_to_users"
                                 referencedTableName="users" referencedColumnNames="id"/>
    </changeSet>

